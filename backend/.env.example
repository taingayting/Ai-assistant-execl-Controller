# Copy this file to .env and fill in your real values
GROQ_API_KEY=your-groq-api-key-here
# Optional overrides:
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=llama3-8b-8192

# ── LLM routing ───────────────────────────────────────────────
# GROQ_FIRST=true  → use Groq BEFORE Ollama (faster when online)
# GROQ_FIRST=false → use Ollama first, Groq as cloud fallback (offline-first)
GROQ_FIRST=false

# ── Ollama (local fallback) ────────────────────────────────────
# Enable/disable Ollama (default: true — required for offline mode)
USE_OLLAMA=true
# Model name pulled in Ollama — qwen3:8b is recommended for JSON accuracy
OLLAMA_MODEL=qwen3:8b
# Ollama server base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
# Request timeout in seconds (default: 30)
# OLLAMA_TIMEOUT=30

# ── Text-to-Speech (pyttsx3) ──────────────────────────────────
# Enable voice feedback after command execution (default: false)
ENABLE_TTS=true
# Speech rate in words-per-minute (default: 170)
# TTS_RATE=170
# Volume 0.0–1.0 (default: 0.9)
# TTS_VOLUME=0.9
